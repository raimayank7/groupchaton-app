{
 "name": "Make Scanned PDF Searchable (OCR) · Infinity",
 "short_name": "Make",
 "id": "/t/pdf-ocr/",
 "description": "Read the text in a scanned PDF on your device and add an invisible text layer so you can search, select and copy it.",
 "start_url": "/t/pdf-ocr/",
 "scope": "/t/pdf-ocr/",
 "display": "standalone",

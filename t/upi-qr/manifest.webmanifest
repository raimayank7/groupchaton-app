{
 "name": "UPI Payment QR · Infinity",
 "short_name": "UPI Payment QR",
 "id": "/t/upi-qr/",
 "description": "Make a UPI payment QR code with your UPI ID, an optional fixed amount and note, and download a printable “Scan & Pay” card.",
 "start_url": "/t/upi-qr/",
 "scope": "/t/upi-qr/",
 "display": "standalone",
 "display_override": [
  "window-controls-overlay",
  "standalone"
 ],
 "launch_handler": {
  "client_mode": "focus-existing"
 },
 "orientation": "any",
 "background_color": "#05060F",
 "theme_color": "#05060F",
 "lang": "en",
 "dir": "ltr",
 "icons": [
  {
   "src": "/assets/brand/favicon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/assets/brand/favicon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/assets/brand/app-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ]
}
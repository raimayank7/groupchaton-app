{
 "name": "Share a Riddle as an Image · Infinity",
 "short_name": "Share",
 "id": "/t/riddle-share/",
 "description": "Turn any riddle into a colourful picture for WhatsApp, Instagram or Facebook: pick one of ours or write your own, choose colours and size, hide or flip the answer.",
 "start_url": "/t/riddle-share/",
 "scope": "/t/riddle-share/",
 "display": "standalone",
 "display_override": [
  "window-controls-overlay",
  "standalone"
 ],
 "launch_handler": {
  "client_mode": "focus-existing"
 },
 "orientation": "any",
 "background_color": "#05060F",
 "theme_color": "#05060F",
 "lang": "en",
 "dir": "ltr",
 "icons": [
  {
   "src": "/assets/brand/favicon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/assets/brand/favicon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/assets/brand/app-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ]
}
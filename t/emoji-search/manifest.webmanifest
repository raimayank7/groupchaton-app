{
 "name": "Emoji Search · Infinity",
 "short_name": "Emoji Search",
 "id": "/t/emoji-search/",
 "description": "Search over 1,000 emoji by any word, tap to copy, and build a string of several to paste.",
 "start_url": "/t/emoji-search/",
 "scope": "/t/emoji-search/",
 "display": "standalone",
 "display_override": [
  "window-controls-overlay",
  "standalone"
 ],
 "launch_handler": {
  "client_mode": "focus-existing"
 },
 "orientation": "any",
 "background_color": "#05060F",
 "theme_color": "#05060F",
 "lang": "en",
 "dir": "ltr",
 "icons": [
  {
   "src": "/assets/brand/favicon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/assets/brand/favicon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/assets/brand/app-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ]
}
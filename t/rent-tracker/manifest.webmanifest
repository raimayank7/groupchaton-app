 "background_color": "#05060F",
 "theme_color": "#05060F",
 "lang": "en",
 "dir": "ltr",
 "icons": [
  {
   "src": "/assets/brand/favicon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/assets/brand/favicon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/assets/brand/app-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ]
}
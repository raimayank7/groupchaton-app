{
 "name": "Rent Tracker for Landlords · Infinity",
 "short_name": "Rent",
 "id": "/t/rent-tracker/",
 "description": "Track tenants, monthly rent, payments and dues; make rent receipts and send reminders on WhatsApp.",
 "start_url": "/t/rent-tracker/",

{
 "name": "Favicon Generator · Infinity",
 "short_name": "Favicon",
 "id": "/t/favicon/",
 "description": "Create a full favicon pack (ICO, 16–512 px PNG, Apple and Android icons, manifest) from a logo, letter or emoji.",
 "start_url": "/t/favicon/",
 "scope": "/t/favicon/",
 "display": "standalone",
 "display_override": [
  "window-controls-overlay",
  "standalone"
 ],
 "launch_handler": {
  "client_mode": "focus-existing"
 },
 "orientation": "any",
 "background_color": "#05060F",
 "theme_color": "#05060F",
 "lang": "en",
 "dir": "ltr",
 "icons": [
  {
   "src": "/assets/brand/favicon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/assets/brand/favicon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/assets/brand/app-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ]
}